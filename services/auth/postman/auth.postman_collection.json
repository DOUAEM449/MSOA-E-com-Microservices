    {
      "name": "Login - 200 user + token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test(\"Has user and token\", () => { pm.expect(b).to.have.all.keys(\"user\",\"token\"); pm.expect(b.token).to.be.a(\"string\").and.not.empty; });",
              "pm.collectionVariables.set(\"token\", b.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
