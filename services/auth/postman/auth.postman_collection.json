              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"User schema\", () => { const u = pm.response.json(); pm.expect(u).to.have.all.keys(\"id\",\"name\",\"email\",\"role\"); pm.expect(u).to.not.have.property(\"password\"); });",
              "pm.test(\"Same e-mail\", () => pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get(\"email\")));"
            ]
          }
        }
